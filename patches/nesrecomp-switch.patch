+/* Checked build facts, independent of the game title and host platform.
+ * This first profile publishes constraints; it adds no new execution shortcuts.
+ */
+#pragma once
+#include "cyc_core.h"
+#include "../../common/nes_cart.h"
+#ifndef NESRECOMP_PROFILE_NROM_NTSC
+#define NESRECOMP_PROFILE_NROM_NTSC 0
+#endif
+static inline bool cyc_profile_accepts(const NesCartInfo *cart, CycRegion region)
+{
+#if NESRECOMP_PROFILE_NROM_NTSC
+    return cart->mapper == 0 && cart->submapper == 0 && !cart->console &&
+           (!cart->nes2 || cart->timing == 0 || cart->timing == 2) && region == CYC_REGION_NTSC;
+#else
+    (void)cart; (void)region;
+    return true;
+#endif
+}
diff --git a/runner/cyc/cyc_profiler.c b/runner/cyc/cyc_profiler.c
new file mode 100644
index 0000000..1ebab4f
--- /dev/null
+++ b/runner/cyc/cyc_profiler.c
@@ -0,0 +1,67 @@
+#include "cyc_profiler.h"
+#if NESRECOMP_CORE_PROFILER
+#include <string.h>
+
+CycProfileBin cyc_profile_bins[CYC_PROFILE_COUNT];
+uint64_t (*cyc_profile_clock)(void);
+double cyc_profile_timer_cost;
+
+void cyc_profiler_reset(void)
+{
+    memset(cyc_profile_bins, 0, sizeof(cyc_profile_bins));
+    for (unsigned i = 0; i < CYC_PROFILE_COUNT; ++i) {
+        cyc_profile_bins[i].random = 0x9e3779b9u * (i + 1);
+        cyc_profile_bins[i].next = 1;
+    }
+}
+
+void cyc_profiler_set_clock(uint64_t (*clock)(void))
+{
+    cyc_profile_clock = clock;
+    cyc_profile_timer_cost = 0;
+    cyc_profiler_reset();
+    if (clock) {
+        for (unsigned i = 0; i < 1024; ++i) {
+            CycProfileBin *bin = &cyc_profile_bins[CYC_PROFILE_PPU_DOT];
+            bin->next = bin->calls + 1;
+            uint64_t started = cyc_profiler_begin(CYC_PROFILE_PPU_DOT);
+            cyc_profiler_end(CYC_PROFILE_PPU_DOT, started);
+        }
+        const CycProfileBin *bin = &cyc_profile_bins[CYC_PROFILE_PPU_DOT];
+        if (bin->samples) cyc_profile_timer_cost = (double)bin->ticks / bin->samples;
+    }
+    cyc_profiler_reset();
+}
+
+void cyc_profiler_report(FILE *file, uint64_t frames, uint64_t frequency, uint64_t emulation_ticks)
+{
+    static const char *names[] = {"ppu_dot", "ppu_half", "ppu_tail", "ppu_native", "apu_cycle", "apu_native"};
+    if (!frames || !frequency) return;
+    double scale = 1000.0 / (double)frequency / (double)frames;
+    double ppu = 0, apu = 0;
+    for (unsigned i = 0; i < CYC_PROFILE_COUNT; ++i) {
+        const CycProfileBin *bin = &cyc_profile_bins[i];
+        /* Subtract timer cost after averaging: clamping each short sample
+         * separately biases estimates upward on coarse hardware counters. */
+        double corrected = (double)bin->ticks - bin->samples * cyc_profile_timer_cost;
+        double mean = bin->samples && corrected > 0 ? corrected * (double)bin->calls / (double)bin->samples * scale : 0;
+        /* Median of interleaved group means limits isolated scheduler pauses.
+         * Keep the raw mean visible: rare real work may also be downweighted. */
+        double groups[9]; unsigned count = 0;
+        for (unsigned g = 0; g < 9; ++g) if (bin->group_samples[g]) {
+            double value = (double)bin->group_ticks[g] / bin->group_samples[g] - cyc_profile_timer_cost;
+            unsigned pos = count++;
+            while (pos && groups[pos - 1] > value) { groups[pos] = groups[pos - 1]; --pos; }
+            groups[pos] = value;
+        }
+        double typical = count ? groups[count / 2] : 0;
+        double estimate = typical > 0 ? typical * (double)bin->calls * scale : 0;
+        if (i <= CYC_PROFILE_PPU_NATIVE) ppu += estimate; else apu += estimate;
+        fprintf(file, "core_profile path=%s estimated_ms=%.3f mean_ms=%.3f calls=%llu samples=%llu\n",
+            names[i], estimate, mean, (unsigned long long)bin->calls, (unsigned long long)bin->samples);
+    }
+    fprintf(file, "core_profile estimated_ppu_ms=%.3f estimated_apu_ms=%.3f residual_ms=%.3f timer_pair_ticks=%.3f\n",
+        ppu, apu, emulation_ticks * scale - ppu - apu, cyc_profile_timer_cost);
+    cyc_profiler_reset();
+}
+#endif
diff --git a/runner/cyc/cyc_profiler.h b/runner/cyc/cyc_profiler.h
new file mode 100644
index 0000000..f4a14a0
--- /dev/null
+++ b/runner/cyc/cyc_profiler.h
@@ -0,0 +1,54 @@
+/* Optional host-time sampling, outside the guest state/save domain. */
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#ifndef NESRECOMP_CORE_PROFILER
+#define NESRECOMP_CORE_PROFILER 0
+#endif
+
+#if NESRECOMP_CORE_PROFILER
+typedef enum {
+    CYC_PROFILE_PPU_DOT, CYC_PROFILE_PPU_HALF, CYC_PROFILE_PPU_TAIL,
+    CYC_PROFILE_PPU_NATIVE, CYC_PROFILE_APU_CYCLE, CYC_PROFILE_APU_NATIVE,
+    CYC_PROFILE_COUNT
+} CycProfileKind;
+typedef struct {
+    uint64_t calls, samples, ticks, next;
+    uint64_t group_ticks[9], group_samples[9];
+    uint32_t random;
+} CycProfileBin;
+extern CycProfileBin cyc_profile_bins[CYC_PROFILE_COUNT];
+extern uint64_t (*cyc_profile_clock)(void);
+extern double cyc_profile_timer_cost;
+void cyc_profiler_reset(void);
+void cyc_profiler_set_clock(uint64_t (*clock)(void));
+void cyc_profiler_report(FILE *file, uint64_t frames, uint64_t frequency, uint64_t emulation_ticks);
+
+static inline uint64_t cyc_profiler_begin(CycProfileKind kind)
+{
+    CycProfileBin *bin = &cyc_profile_bins[kind];
+    ++bin->calls;
+    if (!cyc_profile_clock || bin->calls < bin->next) return 0;
+    /* Random gaps avoid synchronizing samples with scanlines or APU periods.
+     * Only sampled calls update the PRNG; mean gap is about 1024 calls. */
+    uint32_t x = bin->random;
+    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+    bin->random = x;
+    bin->next = bin->calls + 1 + (x & 2047);
+    return cyc_profile_clock();
+}
+
+static inline void cyc_profiler_end(CycProfileKind kind, uint64_t started)
+{
+    if (!started) return;
+    uint64_t ended = cyc_profile_clock();
+    CycProfileBin *bin = &cyc_profile_bins[kind];
+    if (ended >= started) {
+        unsigned group = (unsigned)(bin->samples % 9);
+        bin->ticks += ended - started;
+        bin->group_ticks[group] += ended - started;
+        ++bin->group_samples[group];
+        ++bin->samples;
+    }
+}
+#endif
