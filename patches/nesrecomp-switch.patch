diff --git a/runner/cyc/profile.cmake b/runner/cyc/profile.cmake
new file mode 100644
index 0000000..0fc71c1
--- /dev/null
+++ b/runner/cyc/profile.cmake
@@ -0,0 +1,57 @@
+# Optional, platform-independent build contracts and static optimization modules.
+include_guard(GLOBAL)
+
+function(nesrecomp_cyc_configure_profile target)
+    cmake_parse_arguments(PROFILE "" "HARDWARE;ROM;RECOMPILER;REGION" "OPTIMIZATION_MODULES" ${ARGN})
+    if(NOT PROFILE_HARDWARE)
+        set(PROFILE_HARDWARE generic)
+    endif()
+    if(NOT PROFILE_HARDWARE MATCHES "^(generic|nrom-ntsc)$")
+        message(FATAL_ERROR "Unknown cycle hardware profile: ${PROFILE_HARDWARE}")
+    endif()
+    if(PROFILE_HARDWARE STREQUAL "nrom-ntsc")
+        if(PROFILE_REGION AND NOT PROFILE_REGION STREQUAL "NTSC")
+            message(FATAL_ERROR "nrom-ntsc requires REGION NTSC")
+        endif()
+        # Ask the same host decoder used by generation; it includes known-dump
+        # mapper corrections. Do not infer the effective board from a filename.
+        get_filename_component(rom "${PROFILE_ROM}" ABSOLUTE)
+        if(rom MATCHES "[\r\n]")
+            message(FATAL_ERROR "Hardware profile ROM paths cannot contain line breaks")
+        endif()
+        set(input "${CMAKE_CURRENT_BINARY_DIR}/${target}-profile-input.txt")
+        file(WRITE "${input}" "${rom}\n")
+        execute_process(COMMAND "${PROFILE_RECOMPILER}" --cart-info INPUT_FILE "${input}"
+            OUTPUT_VARIABLE board ERROR_VARIABLE error RESULT_VARIABLE result)
+        if(NOT result EQUAL 0 OR NOT board MATCHES "^CART 0 0 ")
+            message(FATAL_ERROR "nrom-ntsc requires a decoded mapper-0/submapper-0 cartridge: ${board}${error}")
+        endif()
+        file(READ "${rom}" header OFFSET 7 LIMIT 6 HEX)
+        string(SUBSTRING "${header}" 0 2 flags7)
+        string(SUBSTRING "${header}" 10 2 timing)
+        math(EXPR console "0x${flags7} & 3")
+        math(EXPR nes2 "0x${flags7} & 12")
+        math(EXPR timing "0x${timing} & 3")
+        # Legacy timing is unspecified in the core; NES2 multi-region defaults
+        # to NTSC. PAL-only and Dendy are not eligible for this contract.
+        if(console OR (nes2 EQUAL 8 AND NOT (timing EQUAL 0 OR timing EQUAL 2)))
+            message(FATAL_ERROR "nrom-ntsc requires standard NES NTSC-compatible timing")
+        endif()
+        target_compile_definitions(${target} PRIVATE NESRECOMP_PROFILE_NROM_NTSC=1)
+    endif()
+    set_property(TARGET ${target} PROPERTY NESRECOMP_HARDWARE_PROFILE "${PROFILE_HARDWARE}")
+
+    # Modules are trusted build code, scoped to this target. They add sources or
+    # select existing core options at configure time, without a runtime loader.
+    foreach(module IN LISTS PROFILE_OPTIMIZATION_MODULES)
+        get_filename_component(module "${module}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
+        if(NOT EXISTS "${module}" OR IS_DIRECTORY "${module}")
+            message(FATAL_ERROR "Missing cycle optimization module: ${module}")
+        endif()
+        set(NESRECOMP_OPTIMIZATION_TARGET "${target}")
+        set(NESRECOMP_OPTIMIZATION_HARDWARE "${PROFILE_HARDWARE}")
+        include("${module}")
+        set_property(TARGET ${target} APPEND PROPERTY NESRECOMP_OPTIMIZATION_MODULES "${module}")
+    endforeach()
+    message(STATUS "${target}: hardware profile ${PROFILE_HARDWARE}")
+endfunction()
