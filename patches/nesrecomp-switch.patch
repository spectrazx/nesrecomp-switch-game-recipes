--- /dev/null
+++ b/runner/cyc/cyc_profiler.h
@@ -0,0 +1,54 @@
+/* Optional host-time sampling, outside the guest state/save domain. */
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#ifndef NESRECOMP_CORE_PROFILER
+#define NESRECOMP_CORE_PROFILER 0
+#endif
+
+#if NESRECOMP_CORE_PROFILER
+typedef enum {
+    CYC_PROFILE_PPU_DOT, CYC_PROFILE_PPU_HALF, CYC_PROFILE_PPU_TAIL,
+    CYC_PROFILE_PPU_NATIVE, CYC_PROFILE_APU_CYCLE, CYC_PROFILE_APU_NATIVE,
+    CYC_PROFILE_COUNT
+} CycProfileKind;
+typedef struct {
+    uint64_t calls, samples, ticks, next;
+    uint64_t group_ticks[9], group_samples[9];
+    uint32_t random;
+} CycProfileBin;
+extern CycProfileBin cyc_profile_bins[CYC_PROFILE_COUNT];
+extern uint64_t (*cyc_profile_clock)(void);
+extern double cyc_profile_timer_cost;
+void cyc_profiler_reset(void);
+void cyc_profiler_set_clock(uint64_t (*clock)(void));
+void cyc_profiler_report(FILE *file, uint64_t frames, uint64_t frequency, uint64_t emulation_ticks);
+
+static inline uint64_t cyc_profiler_begin(CycProfileKind kind)
+{
+    CycProfileBin *bin = &cyc_profile_bins[kind];
+    ++bin->calls;
+    if (!cyc_profile_clock || bin->calls < bin->next) return 0;
+    /* Random gaps avoid synchronizing samples with scanlines or APU periods.
+     * Only sampled calls update the PRNG; mean gap is about 1024 calls. */
+    uint32_t x = bin->random;
+    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+    bin->random = x;
+    bin->next = bin->calls + 1 + (x & 2047);
+    return cyc_profile_clock();
+}
+
+static inline void cyc_profiler_end(CycProfileKind kind, uint64_t started)
+{
+    if (!started) return;
+    uint64_t ended = cyc_profile_clock();
+    CycProfileBin *bin = &cyc_profile_bins[kind];
+    if (ended >= started) {
+        unsigned group = (unsigned)(bin->samples % 9);
+        bin->ticks += ended - started;
+        bin->group_ticks[group] += ended - started;
+        ++bin->group_samples[group];
+        ++bin->samples;
+    }
+}
+#endif
