diff --git a/runner/cyc/tests/profiler_selftest.c b/runner/cyc/tests/profiler_selftest.c
new file mode 100644
index 0000000..9fb2e32
--- /dev/null
+++ b/runner/cyc/tests/profiler_selftest.c
@@ -0,0 +1,40 @@
+#include "cyc_profiler.h"
+#include <assert.h>
+#include <string.h>
+
+static uint64_t tick = 100;
+static uint64_t fake_clock(void) { return ++tick; }
+
+int main(void)
+{
+    cyc_profiler_set_clock(fake_clock);
+    assert(cyc_profile_timer_cost == 1);
+    unsigned work = 0;
+    for (unsigned i = 0; i < 100000; ++i) {
+        uint64_t started = cyc_profiler_begin(CYC_PROFILE_PPU_NATIVE);
+        ++work;
+        if (started) {
+            tick += 5;
+            if (cyc_profile_bins[CYC_PROFILE_PPU_NATIVE].samples == 5) tick += 1000000;
+        }
+        cyc_profiler_end(CYC_PROFILE_PPU_NATIVE, started);
+    }
+    const CycProfileBin *bin = &cyc_profile_bins[CYC_PROFILE_PPU_NATIVE];
+    assert(work == 100000 && bin->calls == 100000);
+    assert(bin->samples > 50 && bin->samples < 200);
+    assert(bin->ticks == 6 * bin->samples + 1000000);
+    FILE *file = tmpfile();
+    assert(file);
+    cyc_profiler_report(file, 100, 1000, 1000000);
+    rewind(file);
+    char text[4096] = {0};
+    fread(text, 1, sizeof(text) - 1, file);
+    assert(strstr(text, "estimated_ppu_ms=5000.000 estimated_apu_ms=0.000 residual_ms=5000.000"));
+    fclose(file);
+    assert(cyc_profile_bins[CYC_PROFILE_PPU_NATIVE].calls == 0);
+    cyc_profiler_set_clock(NULL);
+    assert(cyc_profiler_begin(CYC_PROFILE_APU_CYCLE) == 0);
+    assert(cyc_profile_bins[CYC_PROFILE_APU_CYCLE].calls == 1);
+    puts("Core profiler: sampling, calibration, scheduler-outlier resistance, estimates, reset and missing clock passed");
+    return 0;
+}
