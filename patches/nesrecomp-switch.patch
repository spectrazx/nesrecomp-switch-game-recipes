@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Check optional hardware contracts and target-scoped static build modules.
+
+All cartridge bytes below are an original, synthetic test program.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+
+import nested_build
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--out', type=Path, required=True)
+    ap.add_argument('--recompiler', type=Path, required=True)
+    nested_build.add_arguments(ap)
+    args = ap.parse_args()
+    tc = nested_build.Toolchain.from_args(args)
+    root = Path(__file__).resolve().parents[2]
+    out = args.out.resolve()
+    source = out / 'profile project'
+    source.mkdir(parents=True, exist_ok=True)
+    binary = out / 'build'
+    prg = bytearray([0xea]) * 32768
+    prg[:7] = bytes([0xa9, 0x42, 0x85, 0, 0x4c, 2, 0x80])
+    prg[-6:] = bytes([0, 0x80]) * 3
+    header = bytearray(b'NES\x1a' + bytes([2, 1]) + bytes(10))
+    rom = source / 'original #1.nes'
+    rom.write_bytes(header + prg + bytes(8192))
+    (source / 'module.cmake').write_text(
+        'target_sources(${NESRECOMP_OPTIMIZATION_TARGET} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/module.c")\n'
+        'target_compile_definitions(${NESRECOMP_OPTIMIZATION_TARGET} PRIVATE PROFILE_MODULE_TEST=1)\n'
+        'if(NOT NESRECOMP_OPTIMIZATION_HARDWARE STREQUAL "nrom-ntsc")\n'
+        '  message(FATAL_ERROR "Wrong module hardware context")\nendif()\n', encoding='utf-8')
+    (source / 'module.c').write_text(
+        '#if !PROFILE_MODULE_TEST || !NESRECOMP_PROFILE_NROM_NTSC\n#error Missing target flags\n#endif\n'
+        'int profile_module_probe(void) { return 1; }\n', encoding='utf-8')
+    (source / 'generic.c').write_text(
+        '#if defined(PROFILE_MODULE_TEST) || defined(NESRECOMP_PROFILE_NROM_NTSC)\n'
+        '#error Target flags leaked\n#endif\nint generic_profile_probe(void) { return 0; }\n', encoding='utf-8')
+    cmake = (
+        'cmake_minimum_required(VERSION 3.20)\nproject(ProfileFixture C)\n'
+        'set(NESRECOMP_RECOMP_UI OFF CACHE STRING "" FORCE)\n'
+        f'include("{root.as_posix()}/runner/cyc/project.cmake")\n'
+        f'set(compiler "{args.recompiler.resolve().as_posix()}")\n'
+        'set(TEST_ROM "${CMAKE_CURRENT_SOURCE_DIR}/original #1.nes" CACHE FILEPATH "")\n'
+        'set(TEST_PROFILE nrom-ntsc CACHE STRING "")\n'
+        'set(TEST_MODULE "${CMAKE_CURRENT_SOURCE_DIR}/module.cmake" CACHE FILEPATH "")\n'
+        'set(TEST_REGION "" CACHE STRING "")\n'
+        'nesrecomp_add_cycle_game(qualified ROM "${TEST_ROM}" RECOMPILER "${compiler}" HEADLESS\n'
+        '  HARDWARE_PROFILE "${TEST_PROFILE}" REGION "${TEST_REGION}" OPTIMIZATION_MODULES "${TEST_MODULE}")\n'
+        'nesrecomp_add_cycle_game(generic ROM "${TEST_ROM}" RECOMPILER "${compiler}" HEADLESS)\n'
+        'target_sources(generic PRIVATE generic.c)\n'
+        'get_target_property(profile generic NESRECOMP_HARDWARE_PROFILE)\n'
+        'if(NOT profile STREQUAL "generic")\nmessage(FATAL_ERROR "Default changed")\nendif()\n'
+        'get_target_property(modules generic NESRECOMP_OPTIMIZATION_MODULES)\n'
+        'if(modules)\nmessage(FATAL_ERROR "Module list leaked")\nendif()\n')
+    (source / 'CMakeLists.txt').write_text(cmake, encoding='utf-8')
+
+    def run(command, name, success=True, contains=None):
+        result = subprocess.run(list(map(str, command)), capture_output=True, text=True,
+                                timeout=900, env=tc.environment(), creationflags=nested_build.NO_WINDOW)
+        output = result.stdout + result.stderr
+        (out / f'{name}.log').write_text(output, encoding='utf-8')
+        assert (result.returncode == 0) == success, (name, output[-4000:])
+        if contains:
+            assert contains in output, (name, output[-4000:])
+        return output
+
+    run(tc.configure_command(source, binary), 'configure')
+    run(tc.build_command(binary, 4), 'build')
+    for target in ('qualified', 'generic'):
+        run([tc.executable(binary, target), rom, '--frames', '3', '--no-save', '--hash-out', out / f'{target}.txt'], target)
+    assert (out / 'qualified.txt').read_bytes() == (out / 'generic.txt').read_bytes()
+    run([tc.executable(binary, 'qualified'), rom, '--frames', '3', '--region', 'pal', '--no-save'],
+        'runtime-region', False, 'violates the compiled hardware profile')
+    other = source / 'other.nes'
+    prg[1] ^= 1
+    other.write_bytes(header + prg + bytes(8192))
+    run([tc.executable(binary, 'qualified'), other, '--frames', '3', '--no-save'],
+        'wrong-image', False, 'does not match')
+
+    def reject(name, defines, expected):
+        run(tc.configure_command(source, out / name, defines), name, False, expected)
+
+    reject('unknown-profile', ['-DTEST_PROFILE=typo'], 'Unknown cycle hardware profile')
+    reject('missing-module', ['-DTEST_MODULE=absent.cmake'], 'Missing cycle optimization module')
+    reject('explicit-pal', ['-DTEST_REGION=PAL'], 'nrom-ntsc requires REGION NTSC')
+    header[6] = 0x30
+    other.write_bytes(header + prg + bytes(8192))
+    reject('wrong-board', [f'-DTEST_ROM={other}'], 'requires a decoded mapper-0/submapper-0')
+    header[6], header[7], header[12] = 0, 8, 1
+    other.write_bytes(header + prg + bytes(8192))
+    reject('nes2-pal', [f'-DTEST_ROM={other}'], 'requires standard NES NTSC-compatible timing')
+    header[7], header[12] = 1, 0
+    other.write_bytes(header + prg + bytes(8192))
+    # The existing generator rejects arcade metadata before profile setup.
+    reject('arcade-console', [f'-DTEST_ROM={other}'], 'Cycle code generation failed')
+    logs = list((out / 'arcade-console').glob('cycle-qualified/*/codegen.log'))
+    assert any('unsupported cartridge metadata' in p.read_text() for p in logs)
+    print('Cycle profiles: unchanged frame hashes, target isolation, board/region/module/identity rejection passed')
+
+
+if __name__ == '__main__':
+    main()
