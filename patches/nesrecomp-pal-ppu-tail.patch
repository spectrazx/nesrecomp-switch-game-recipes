+/* PAL has five divider phases and a 16-master-clock CPU cycle. During a
+ * stable visible render span, choose its schedule once instead of dispatching
+ * every dot/half dot through ppu_dot/ppu_half_dot. No guest event is skipped:
+ * retain hw.tick, mapper pin transitions and pre-edge NMI/IRQ sampling. The
+ * tick-zero CPU/APU/cartridge work has already run in the machine. Delayed
+ * register traffic, span boundaries and PAL forced OAM refresh stay generic.
+ * NESRECOMP_PAL_PPU_TAIL_REFERENCE keeps the previous PAL dispatch for A/B. */
+#ifndef NESRECOMP_PAL_PPU_TAIL_REFERENCE
+#define NESRECOMP_PAL_PPU_TAIL_REFERENCE 0
+#endif
+bool ppu_clock_pal_cpu_tail(unsigned phase)
+{
+#if (NESRECOMP_PPU_HLE || !NESRECOMP_PPU_LLE_REFERENCE) && !NESRECOMP_PAL_PPU_TAIL_REFERENCE
+    /* Fifteen master ticks advance exactly three dots. Keep all events
+     * strictly inside the cached render span (dot < 253). */
+    if (dot_kind != DOT_RENDER || ppu.dot >= 250) return false;
+#define PAL_RENDER_STEP(k, phase) do { \
+    hw.tick = (k) + 1; \
+    if ((k) == 6) cpu_nmi_input(ppu_nmi_output()); \
+    else if ((k) == 9) apu_sample_irq(); \
+    if (((phase) + (k)) % 5 == 0) render_clock_dot(); \
+    else if (((phase) + (k)) % 5 == 2) render_span_half_dot(); \
+} while (0)
+#define PAL_RENDER_TAIL(phase) do { \
+    PAL_RENDER_STEP(1, phase); PAL_RENDER_STEP(2, phase); PAL_RENDER_STEP(3, phase); \
+    PAL_RENDER_STEP(4, phase); PAL_RENDER_STEP(5, phase); PAL_RENDER_STEP(6, phase); \
+    PAL_RENDER_STEP(7, phase); PAL_RENDER_STEP(8, phase); PAL_RENDER_STEP(9, phase); \
+    PAL_RENDER_STEP(10, phase); PAL_RENDER_STEP(11, phase); PAL_RENDER_STEP(12, phase); \
+    PAL_RENDER_STEP(13, phase); PAL_RENDER_STEP(14, phase); PAL_RENDER_STEP(15, phase); \
+} while (0)
+    switch (phase) {
+    case 0: PAL_RENDER_TAIL(0); break;
+    case 1: PAL_RENDER_TAIL(1); break;
+    case 2: PAL_RENDER_TAIL(2); break;
+    case 3: PAL_RENDER_TAIL(3); break;
+    default: PAL_RENDER_TAIL(4); break;
+    }
+#undef PAL_RENDER_TAIL
+#undef PAL_RENDER_STEP
+    return true;
+#else
+    (void)phase;
+    return false;
+#endif
+}
