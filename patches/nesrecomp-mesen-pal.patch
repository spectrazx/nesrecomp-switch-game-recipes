+#!/bin/bash
+# Native macOS reference tool. Uses a separate supplied MesenCE libretro checkout.
+set -euo pipefail
+if [[ $# -ne 2 || "$(uname -s)" != Darwin ]]; then
+  printf 'Usage on macOS: bash build.sh MESEN_ROOT OUT_DIR\n' >&2
+  exit 2
+fi
+mesen_root="$(cd "$1" && pwd)"
+mkdir -p "$2"
+out_dir="$(cd "$2" && pwd)"
+source_dir="$(cd "$(dirname "$0")" && pwd)"
+make -C "$mesen_root" -f Makefile.libretro -j"${MESEN_BUILD_JOBS:-4}" \
+  CXX=clang++ CC=clang 'LINKOPTIONS=-Wl,-install_name,@rpath/mesen2_libretro.dylib'
+clang++ -std=c++17 -O2 -DLIBRETRO -I "$mesen_root" -I "$mesen_root/Core" \
+  -I "$mesen_root/Utilities" "$source_dir/mesen_shot.cpp" \
+  "$mesen_root/mesen2_libretro.dylib" -Wl,-rpath,"$mesen_root" -o "$out_dir/mesen_shot"
+printf 'Reference tool: %s/mesen_shot\n' "$out_dir"
