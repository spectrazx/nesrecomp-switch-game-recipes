+}
+static inline bool profiled_ppu_tail(unsigned align) {
+    uint64_t t = cyc_profiler_begin(CYC_PROFILE_PPU_TAIL);
+    bool result = ppu_clock_cpu_tail(align);
+    cyc_profiler_end(CYC_PROFILE_PPU_TAIL, t); return result;
+}
+static inline void profiled_ppu_native(unsigned cycles, unsigned align) {
+    uint64_t t = cyc_profiler_begin(CYC_PROFILE_PPU_NATIVE);
+    ppu_native_interval_run(cycles, align); cyc_profiler_end(CYC_PROFILE_PPU_NATIVE, t);
+}
+static inline void profiled_apu_cycle(void) {
+    uint64_t t = cyc_profiler_begin(CYC_PROFILE_APU_CYCLE);
+    apu_cycle(); cyc_profiler_end(CYC_PROFILE_APU_CYCLE, t);
+}
+static inline void profiled_apu_native(unsigned cycles) {
+    uint64_t t = cyc_profiler_begin(CYC_PROFILE_APU_NATIVE);
+    apu_native_interval_run(cycles); cyc_profiler_end(CYC_PROFILE_APU_NATIVE, t);
+}
+#define ppu_dot profiled_ppu_dot
+#define ppu_half_dot profiled_ppu_half
+#define ppu_clock_cpu_tail profiled_ppu_tail
+#define ppu_native_interval_run profiled_ppu_native
+#define apu_cycle profiled_apu_cycle
+#define apu_native_interval_run profiled_apu_native
+#endif
+
 HwMachine  hw;
 HwExtraTiming hw_extra_timing;
 HwRegionTiming hw_region_timing;
