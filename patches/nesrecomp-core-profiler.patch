+/* Clock boundaries only: no guest cycles, bus accesses, or state changes.
+ * Macros are local to this translation unit, after the real declarations. */
+static inline void profiled_ppu_dot(void) {
+    uint64_t t = cyc_profiler_begin(CYC_PROFILE_PPU_DOT);
+    ppu_dot(); cyc_profiler_end(CYC_PROFILE_PPU_DOT, t);
