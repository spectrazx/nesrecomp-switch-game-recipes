+/* Eight unobserved dots load one output unit. Admission excludes mapper
+ * observers, read-triggered banks, CHR/CIRAM aliasing and recording. Retain
+ * the exact connector and latch state at the boundary, including reads of
+ * pattern bytes for out-of-range sprites and secondary-OAM wrap/full rules. */
+static void sprite_fetch_job(unsigned align)
+{
+    if (align < 2) sprite_fetch_half_dot();
+    unsigned slot = (unsigned)ppu.dot / 8u - 32u;
+    uint8_t y = ppu.oam2[ppu.oam2_addr]; oam2_increment();
+    uint8_t tile = ppu.oam2[ppu.oam2_addr]; oam2_increment();
+    uint8_t attr = ppu.oam2[ppu.oam2_addr]; oam2_increment();
+    uint8_t x = ppu.oam2[ppu.oam2_addr]; oam2_increment();
+    ppu.sprite_row = (uint16_t)((ppu.scanline & 255) - y);
+    ppu.load_tile = tile; ppu.load_attr = attr;
+    ppu.spr_attr[slot] = attr; ppu.spr_x[slot] = x;
+    uint16_t nt = (uint16_t)(0x2000 | (ppu.v & 0x0fff));
+    ppu.fetch_data = ppu.ciram[(nt & 0x3ff) | hw_cart_ciram_a10(nt)];
+    unsigned row = ppu.sprite_row & 7u;
+    if (attr & 0x80) row = 7u - row;
+    uint16_t pattern;
+    if (ppu.sprite16)
+        pattern = (uint16_t)(((tile & 1u) << 12) | ((tile & 0xfeu) << 4) |
+                            row | (((ppu.sprite_row & 8u) ^ ((attr & 0x80) ? 8u : 0u)) << 1));
+    else pattern = (uint16_t)((ppu.sprite_table ? 0x1000 : 0) | (tile << 4) | row);
+    uint8_t lo = hw_cart.chr[hw_cart_chr_index(pattern)];
+    uint8_t hi = hw_cart.chr[hw_cart_chr_index(pattern | 8u)];
+    ppu.par_chr = pattern | 8u;
+    ppu.octal_latch = (uint8_t)ppu.par_chr;
+    ppu.vbus = (uint16_t)((ppu.par_chr & 0xff00) | hi);
+    if (attr & 0x40) { lo = flip_bits(lo); hi = flip_bits(hi); }
+    bool in_range = ppu.sprite_row < (ppu.sprite16 ? 16u : 8u);
+    ppu.spr_lo[slot] = in_range ? lo : 0;
+    ppu.spr_hi[slot] = in_range ? hi : 0;
+    ppu.oam_addr = 0; ppu.cur_has_s0 = ppu.next_has_s0;
+    ppu.oam_latch = ppu.oam_buffer = ppu.oam_buffer_in = x;
+    ppu.blnk_latch = ppu.pal_enable = ppu.copy_v = ppu.ale = ppu.wr = ppu.commit = 0;
+    ppu.rd = 1;
+    ppu.overflow_late = ppu.overflow;
+    ppu.s0hit = ppu.s0hit_late = ppu.s0hit || ppu.s0hit_pending1 || ppu.s0hit_pending2;
+    ppu.s0hit_pending1 = ppu.s0hit_pending2 = 0;
+    ppu.vset_latch2 = 0;
+    for (unsigned i = 1; i < 4; ++i) {
+        ppu.color[i] = ppu.color[0];
+        if (cyc_background_enabled) cyc_background_pipe[i] = cyc_background_pipe[0];
+    }
+    ppu.dot += 8;
+    if (hw_zapper.port) hw_zapper.dots += 8;
