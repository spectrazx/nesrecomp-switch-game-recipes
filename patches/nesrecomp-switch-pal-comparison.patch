+/* Compare the region's shared-core policy; normal launches enable both. */
+static const char *comparison_policy(void)
+{
+    return cyc_region() == CYC_REGION_PAL ? "pal_intervals" : "masked_irq";
+}
+static void comparison_set_enabled(bool enabled)
+{
+    if (cyc_region() == CYC_REGION_PAL) hw_native_set_pal_intervals(enabled);
+    else hw_native_set_masked_irq(enabled);
+}
